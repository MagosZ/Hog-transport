<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Loaded only with Combat Extended: the door guns get the CE values that "VVE - Secondary Weapons" gives the
	     Louie's door guns (its Mods/CombatExtended/Patches/ExistingTurrets_CEPatch.xml): calibre, range, box, reload,
	     fire modes and CE ballistics. -->
	<!-- HogShuttle_DoorMMG -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/projectile</xpath>
		<value><projectile>Bullet_762x51mmNATO_FMJ</projectile></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/reloadTimer</xpath>
		<value><reloadTimer>7.8</reloadTimer></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/warmUpTimer</xpath>
		<value><warmUpTimer>1.2</warmUpTimer></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/magazineCapacity</xpath>
		<value><magazineCapacity>100</magazineCapacity></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/maxRange</xpath>
		<value><maxRange>62</maxRange></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/fireModes</xpath>
		<value>
			<fireModes>
				<li>
					<shotsPerBurst>1</shotsPerBurst>
					<ticksBetweenShots>4</ticksBetweenShots>
					<ticksBetweenBursts>60</ticksBetweenBursts>
					<label>Single</label>
					<texPath>UI/Gizmos/FireRate_Single</texPath>
				</li>
				<li>
					<shotsPerBurst>5</shotsPerBurst>
					<ticksBetweenShots>4</ticksBetweenShots>
					<ticksBetweenBursts>60</ticksBetweenBursts>
					<label>Burst</label>
					<texPath>UI/Gizmos/FireRate_Burst</texPath>
				</li>
				<li>
					<shotsPerBurst>10</shotsPerBurst>
					<ticksBetweenShots>4</ticksBetweenShots>
					<ticksBetweenBursts>60</ticksBetweenBursts>
					<label>Auto</label>
					<texPath>UI/Gizmos/FireRate_Auto</texPath>
				</li>
			</fireModes>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
				<shotHeight>2</shotHeight>
				<speed>156</speed>
				<sway>0.96</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
