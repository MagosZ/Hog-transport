<?xml version="1.0" encoding="utf-8"?>
<!-- Loaded only when Combat Extended is active (see LoadFolders.xml). The Hind Gunship's CE values for its 30 mm cannon. -->
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/projectile</xpath>
		<value>
			<projectile>Bullet_30x165mm_HE</projectile>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_30x165mm</ammoSet>
				<shotHeight>1.5</shotHeight>
				<recoil>0</recoil>
				<speed>165</speed>
				<sway>0.7</sway>
				<spread>0.04</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/description</xpath>
		<value>
			<description>Two 30 mm autocannons bound side by side in a roof mount above the cockpit and fed from a 200-round magazine. The barrels take turns. The mount is fixed forward, so the pilot aims it by turning the shuttle. Reloads with 30x165mm shells (AP, incendiary, HE or sabot).</description>
		</value>
	</Operation>
</Patch>
