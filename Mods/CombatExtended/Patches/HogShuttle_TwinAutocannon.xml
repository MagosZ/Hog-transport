<?xml version="1.0" encoding="utf-8"?>
<!-- Loaded only when Combat Extended is active (see LoadFolders.xml). CE's version of vanilla's autocannon turret, doubled
     where two barrels change the number: burst 10 becomes 20, 7 ticks apart becomes 4 (3.5 rounded up), magazine 100 becomes
     200, and then +50% for 300. Range is 10% under the original's 78 (70.2). Unchanged: no minimum range, warm-up 2.3 s, cooldown 1 s, reload 7.8 s, 20x102mm NATO ammo, sway 1.61, spread
     0.01. Recoil is 0 like the Hind's: Vehicle Framework multiplies it by the shot number, and bursts here are twice as long.
     Speed: that ammo's base speed. -->
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/projectile</xpath>
		<value>
			<projectile>Bullet_20x102mmNATO_AP</projectile>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/minRange</xpath>
		<value>
			<minRange>0</minRange>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/maxRange</xpath>
		<value>
			<maxRange>70.2</maxRange>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>2.3</warmUpTimer>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/magazineCapacity</xpath>
		<value>
			<magazineCapacity>300</magazineCapacity>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/reloadTimer</xpath>
		<value>
			<reloadTimer>7.8</reloadTimer>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/fireModes/li/shotsPerBurst</xpath>
		<value>
			<shotsPerBurst>20</shotsPerBurst>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/fireModes/li/ticksBetweenShots</xpath>
		<value>
			<ticksBetweenShots>4</ticksBetweenShots>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/fireModes/li/ticksBetweenBursts</xpath>
		<value>
			<ticksBetweenBursts>60</ticksBetweenBursts>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_20x102mmNATO</ammoSet>
				<shotHeight>1.5</shotHeight>
				<recoil>0</recoil>
				<speed>182</speed>
				<sway>1.61</sway>
				<spread>0.01</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_TwinAutocannon"]/description</xpath>
		<value>
			<description>Two autocannons bound side by side in a roof mount and fed from a 300-round magazine. The mount is fixed forward, so the pilot aims it by turning the shuttle. Reloads with 20x102mm shells.</description>
		</value>
	</Operation>
</Patch>
