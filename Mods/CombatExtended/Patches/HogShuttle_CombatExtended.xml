<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Loaded only with Combat Extended (LoadFolders.xml). Without CE the vanilla ratings in Defs/ apply.
	     Generated by Source/Art/components.py. Each armour class takes the Hind Gunship's CE rating for the
	     matching part, scaled by the Hog's vanilla rating over the Hind's: hull and wings = Hind body, cockpit =
	     Hind cockpit, outer parts = Hind engines, inner parts = Hind fuel tank. The plasteel armour upgrade adds
	     20% of these, in place of 20% of the vanilla ratings. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="HogShuttle"]/components/li[key="Hull"]/armor</xpath>
		<value>
			<armor>
				<ArmorRating_Blunt>22.5</ArmorRating_Blunt>
