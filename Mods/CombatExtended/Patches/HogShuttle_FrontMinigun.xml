<?xml version="1.0" encoding="utf-8"?>
<!-- Loaded only when Combat Extended is active (see LoadFolders.xml). The values VVE - Secondary Weapons' CE patch gives
     TGBM_ExposedMinigun, with recoil 0 and a shot height of 1.5 like the autocannon's: sway and spread are fixed, so accuracy
     doesn't depend on a crew. -->
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/projectile</xpath>
		<value>
			<projectile>Bullet_762x51mmNATO_FMJ</projectile>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/reloadTimer</xpath>
		<value>
			<reloadTimer>9.2</reloadTimer>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/warmUpTimer</xpath>
		<value>
			<warmUpTimer>2.07</warmUpTimer>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/magazineCapacity</xpath>
		<value>
			<magazineCapacity>2000</magazineCapacity>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/maxRange</xpath>
		<value>
			<maxRange>62</maxRange>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/fireModes</xpath>
		<value>
			<fireModes>
				<li>
					<shotsPerBurst>1</shotsPerBurst>
					<ticksBetweenShots>1</ticksBetweenShots>
					<ticksBetweenBursts>21</ticksBetweenBursts>
					<label>Single</label>
					<texPath>UI/Gizmos/FireRate_Single</texPath>
				</li>
				<li>
					<shotsPerBurst>25</shotsPerBurst>
					<ticksBetweenShots>1</ticksBetweenShots>
					<ticksBetweenBursts>21</ticksBetweenBursts>
					<label>Burst</label>
					<texPath>UI/Gizmos/FireRate_Burst</texPath>
				</li>
				<li>
					<shotsPerBurst>50</shotsPerBurst>
					<ticksBetweenShots>1</ticksBetweenShots>
					<ticksBetweenBursts>21</ticksBetweenBursts>
					<label>Auto</label>
					<texPath>UI/Gizmos/FireRate_Auto</texPath>
				</li>
			</fireModes>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]</xpath>
		<value>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
				<shotHeight>1.5</shotHeight>
				<recoil>0</recoil>
				<speed>156</speed>
				<sway>1.02</sway>
				<spread>0.06</spread>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_FrontMinigun"]/description</xpath>
		<value>
			<description>A rotary machine gun slung under the starboard wing beside the cockpit and fed from a 2000-round box. The mount is fixed forward, so the pilot aims it by turning the shuttle. Reloads with 7.62x51mm NATO cartridges.</description>
		</value>
	</Operation>
</Patch>
