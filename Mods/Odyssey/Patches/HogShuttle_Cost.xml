<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Loaded only with Odyssey (LoadFolders.xml): 2 shuttle engines instead of 25 of the advanced components the base
	     cost has. Both costs come to the same market value, 11265, a little under VVE's Cherokee (11744). -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleBuildDef[defName="HogShuttle_Blueprint"]/costList/ComponentSpacer</xpath>
		<value>
			<ComponentSpacer>3</ComponentSpacer>
			<ShuttleEngine>2</ShuttleEngine>
		</value>
	</Operation>
</Patch>
