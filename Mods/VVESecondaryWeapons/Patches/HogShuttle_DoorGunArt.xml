<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Loaded only with "VVE - Secondary Weapons" (tgbm.vve.secondary.weapons, LoadFolders.xml): the door guns use
	     that mod's own gun art (by path, nothing copied into this mod), its shot sounds, and its turret icon in the
	     Upgrades tab. Without it they keep the placeholder art in Textures/HogShuttle and vanilla sounds. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/graphicData</xpath>
		<value>
			<graphicData>
				<texPath>Things/Vehicles/Armament/TGBM_M240_shield_c</texPath>
				<graphicClass>Vehicles.Graphic_Turret</graphicClass>
				<shaderType>CutoutComplexPattern</shaderType>
				<drawSize>(2.2, 2.2)</drawSize>
			</graphicData>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMMG"]/shotSound</xpath>
		<value><shotSound>TGBM_Shot_MediumMachineGun</shotSound></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="HogShuttle_UpgradeTree"]/nodes/li[key="HogShuttle_DoorGunMMG"]/icon</xpath>
		<value><icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorHMG"]/graphicData</xpath>
		<value>
			<graphicData>
				<texPath>Things/Vehicles/Armament/TGBM_M2HB_shield_b</texPath>
				<graphicClass>Vehicles.Graphic_Turret</graphicClass>
				<shaderType>CutoutComplexPattern</shaderType>
				<drawSize>(2.5, 2.5)</drawSize>
			</graphicData>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorHMG"]/shotSound</xpath>
		<value><shotSound>TGBM_Shot_HeavyMachineGun</shotSound></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="HogShuttle_UpgradeTree"]/nodes/li[key="HogShuttle_DoorGunHMG"]/icon</xpath>
		<value><icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="HogShuttle_DoorMinigun"]/graphicData</xpath>
		<value>
			<graphicData>
				<texPath>Things/TGBM_ThirdParty_Vehicles/GHTek_M134</texPath>
				<graphicClass>Vehicles.Graphic_Turret</graphicClass>
				<shaderType>Cutout</shaderType>
				<drawSize>(2.5, 2.5)</drawSize>
			</graphicData>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="HogShuttle_UpgradeTree"]/nodes/li[key="HogShuttle_DoorGunMinigun"]/icon</xpath>
		<value><icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon></value>
	</Operation>
</Patch>
