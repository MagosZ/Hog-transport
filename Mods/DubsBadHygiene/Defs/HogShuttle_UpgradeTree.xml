<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Loaded only with Dubs Bad Hygiene (LoadFolders.xml); Patches/HogShuttle_Upgrades.xml gives the Hog this tree. -->
	<Vehicles.UpgradeTreeDef>
		<defName>HogShuttle_UpgradeTree</defName>
		<nodes>
			<!-- No Vehicle Framework effect of its own: HogShuttle.dll refills the bladder of everyone aboard while
			     the node is installed (UpgradeNeedRefillExtension on the Hog). Vehicle Framework's turret code
			     reads every node's upgrades list without a null check, so give this node an empty
			     <upgrades /> once the Hog gets turrets. -->
			<li>
				<key>HogShuttle_ChemicalToilet</key>
				<label>Chemical toilet</label>
				<description>Keeps the bladder of everyone aboard satisfied.</description>
				<icon>HogShuttle/Upgrade_ChemicalToilet</icon>
				<gridCoordinate>(4, 4)</gridCoordinate>
				<!-- A wooden wall's work: 135 (Wall) x 0.7 (wood). -->
				<work>95</work>
				<ingredients>
					<Steel>10</Steel>
					<Neutroamine>10</Neutroamine>
				</ingredients>
			</li>
		</nodes>
	</Vehicles.UpgradeTreeDef>
</Defs>
