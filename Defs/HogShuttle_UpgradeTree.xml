<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- The Hog's Upgrades tab. With Dubs Bad Hygiene, Mods/DubsBadHygiene/Patches/HogShuttle_Upgrades.xml adds the
	     chemical toilet node.
	     Nodes here have no Vehicle Framework effect of their own; HogShuttle.dll checks whether they're installed.
	     Vehicle Framework's turret code reads every node's upgrades list without a null check, so give each
	     node an empty <upgrades /> once the Hog gets turrets. -->
	<Vehicles.UpgradeTreeDef>
		<defName>HogShuttle_UpgradeTree</defName>
		<nodes>
			<!-- 20% less fuel for world-map travel: the fuel rate 300 less 60. Vehicle Framework's launch cost and in-flight burn
			     follow the rate, and HogShuttle.dll scales the fee for changing layer with it. VTOL Vehicle's hover burn on the local
			     map is its own, so this doesn't touch it. -->
			<li>
				<key>HogShuttle_FlightComputer</key>
				<label>Auxiliary flight computer</label>
				<description>Plots more efficient courses: 20% less fuel for travel on the world map and to and from space.</description>
				<icon>HogShuttle/Upgrade_FlightComputer</icon>
				<gridCoordinate>(4, 4)</gridCoordinate>
				<work>200</work>
				<ingredients>
					<ComponentSpacer>1</ComponentSpacer>
				</ingredients>
				<upgrades>
					<li Class="Vehicles.StatUpgrade">
						<statCategories>
							<li>
								<def>FuelConsumptionRate</def>
								<value>-60</value>
							</li>
						</statCategories>
					</li>
				</upgrades>
			</li>

			<!-- Like the Hind Gunship's Plasteel Armour (same cost and work), but the cockpit is plated too. Adds 20% of
			     each component's own rating (Defs/VehicleDefs/HogShuttle.xml); the plates cost 200 kg of cargo.
			     Combat Extended swaps the amounts for 20% of its ratings
			     (Mods/CombatExtended/Patches/HogShuttle_CombatExtended.xml). -->
			<li>
				<key>HogShuttle_PlasteelArmour</key>
				<label>Plasteel armour</label>
				<description>Plasteel plates over the whole airframe: about 20% more armour on every part, at the cost of 200 kg of cargo space.</description>
				<icon>HogShuttle/Upgrade_PlasteelArmour</icon>
				<gridCoordinate>(16, 4)</gridCoordinate>
				<work>6000</work>
				<ingredients>
					<Plasteel>150</Plasteel>
					<ComponentIndustrial>4</ComponentIndustrial>
				</ingredients>
				<upgrades>
					<li Class="Vehicles.VehicleUpgrade">
						<armor>
							<li>
								<key>Hull</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.18</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>Cockpit</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>ThrusterPort</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>ThrusterStarboard</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>WingPort</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.18</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>WingStarboard</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.18</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>SkidFront</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>SkidPort</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>SkidStarboard</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>RearDoor</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>FuelIntake</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.09</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.16</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>FuelPumps</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.08</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>FuelTank</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.08</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>Avionics</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.08</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>CabinSeats</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.08</ArmorRating_Sharp>
								</statModifiers>
							</li>
							<li>
								<key>ControlServos</key>
								<type>Add</type>
								<statModifiers>
									<ArmorRating_Blunt>0.05</ArmorRating_Blunt>
									<ArmorRating_Sharp>0.08</ArmorRating_Sharp>
								</statModifiers>
							</li>
						</armor>
					</li>
					<li Class="Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>CargoCapacity</def>
								<value>-200</value>
								<type>Add</type>
							</li>
						</vehicleStats>
					</li>
				</upgrades>
			</li>

			<!-- Like the Hind Gunship's Cabin Modification / Cargo Conversion: editing the Passenger role's slots (editKey)
			     and adding cargo. Stacks with the plasteel armour (1000 - 200 + 1000 = 1800 kg). Vehicle Framework
			     doesn't unload pawns when a role edit lowers the slots, so unload passengers before fitting it. -->
			<li>
				<key>HogShuttle_CargoOutfit</key>
				<label>Cargo outfit</label>
				<description>Swaps six of the passenger seats for tie-down points: 2 passenger seats, 1000 kg more cargo space.</description>
				<icon>HogShuttle/Upgrade_CargoOutfit</icon>
				<gridCoordinate>(22, 4)</gridCoordinate>
				<work>500</work>
				<upgrades>
					<li Class="Vehicles.VehicleUpgrade">
						<roles>
							<li>
								<key>Passenger</key>
								<editKey>Passenger</editKey>
								<slots>2</slots>
							</li>
						</roles>
					</li>
					<li Class="Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>CargoCapacity</def>
								<value>1000</value>
								<type>Add</type>
							</li>
						</vehicleStats>
					</li>
				</upgrades>
			</li>

			<!-- Rear door guns: the Louie's three door-gun options in "VVE - Secondary Weapons" (a dependency), using its
			     turret defs, art, sounds and Combat Extended patch as they are; one gun each, so half its price and work.
			     Only one can be fitted. Fitting one adds a door gunner seat at the tail (B7-C7, exposed,
			     the door is open); the role comes first so the turret is manned as soon as it is added. The turret is
			     VTOL Vehicle's class so it follows the aircraft's heading. Arc: 60 degrees either side of straight back
			     (0 = the nose). -->
			<li>
				<key>HogShuttle_DoorGunMMG</key>
				<label>Door gun: medium machine gun</label>
				<description>A rifle-calibre machine gun on a pintle at the rear door, worked by a door gunner. Fires 60 degrees either side of straight back.</description>
				<icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon>
				<gridCoordinate>(4, 10)</gridCoordinate>
				<work>5000</work>
				<ingredients>
					<Steel>150</Steel>
					<ComponentIndustrial>5</ComponentIndustrial>
				</ingredients>
				<disableIfUpgradeNodesEnabled>
					<li>HogShuttle_DoorGunHMG</li>
					<li>HogShuttle_DoorGunMinigun</li>
				</disableIfUpgradeNodesEnabled>
				<upgrades>
					<li Class="Vehicles.VehicleUpgrade">
						<roles>
							<li>
								<key>DoorGunner</key>
								<label>door gunner</label>
								<handlingTypes>Turret</handlingTypes>
								<slots>1</slots>
								<slotsToOperate>1</slotsToOperate>
								<turretIds>
									<li>doorGun</li>
								</turretIds>
								<hitbox>
									<cells>
										<li>(0, -3)</li>
										<li>(1, -3)</li>
									</cells>
								</hitbox>
								<exposed>true</exposed>
								<chanceToHit>0.3</chanceToHit>
							</li>
						</roles>
					</li>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li Class="VTOLVehicle.VtolVehicleTurret">
								<turretDef>TGBM_WisentMMG</turretDef>
								<renderProperties>
									<north>(0, -3.1)</north>
								</renderProperties>
								<gizmoLabel>Door gun</gizmoLabel>
								<defaultAngleRotated>180</defaultAngleRotated>
								<angleRestricted>(120, 240)</angleRestricted>
								<aimPieOffset>(0, -3.1)</aimPieOffset>
								<rotateVehicleToTargetWhileTargeting>false</rotateVehicleToTargetWhileTargeting>
								<returnToDefaultAfterTicks>180</returnToDefaultAfterTicks>
								<drawLayer>1</drawLayer>
								<key>doorGun</key>
							</li>
						</turrets>
					</li>
				</upgrades>
			</li>
			<li>
				<key>HogShuttle_DoorGunHMG</key>
				<label>Door gun: heavy machine gun</label>
				<description>A heavy machine gun on a pintle at the rear door, worked by a door gunner. Fires 60 degrees either side of straight back.</description>
				<icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon>
				<gridCoordinate>(10, 10)</gridCoordinate>
				<work>5000</work>
				<ingredients>
					<Steel>205</Steel>
					<ComponentIndustrial>6</ComponentIndustrial>
				</ingredients>
				<disableIfUpgradeNodesEnabled>
					<li>HogShuttle_DoorGunMMG</li>
					<li>HogShuttle_DoorGunMinigun</li>
				</disableIfUpgradeNodesEnabled>
				<upgrades>
					<li Class="Vehicles.VehicleUpgrade">
						<roles>
							<li>
								<key>DoorGunner</key>
								<label>door gunner</label>
								<handlingTypes>Turret</handlingTypes>
								<slots>1</slots>
								<slotsToOperate>1</slotsToOperate>
								<turretIds>
									<li>doorGun</li>
								</turretIds>
								<hitbox>
									<cells>
										<li>(0, -3)</li>
										<li>(1, -3)</li>
									</cells>
								</hitbox>
								<exposed>true</exposed>
								<chanceToHit>0.3</chanceToHit>
							</li>
						</roles>
					</li>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li Class="VTOLVehicle.VtolVehicleTurret">
								<turretDef>TGBM_WisentHMG</turretDef>
								<renderProperties>
									<north>(0, -3.1)</north>
								</renderProperties>
								<gizmoLabel>Door gun</gizmoLabel>
								<defaultAngleRotated>180</defaultAngleRotated>
								<angleRestricted>(120, 240)</angleRestricted>
								<aimPieOffset>(0, -3.1)</aimPieOffset>
								<rotateVehicleToTargetWhileTargeting>false</rotateVehicleToTargetWhileTargeting>
								<returnToDefaultAfterTicks>180</returnToDefaultAfterTicks>
								<drawLayer>1</drawLayer>
								<key>doorGun</key>
							</li>
						</turrets>
					</li>
				</upgrades>
			</li>
			<li>
				<key>HogShuttle_DoorGunMinigun</key>
				<label>Door gun: minigun</label>
				<description>A minigun on a pintle at the rear door, worked by a door gunner. Fires 60 degrees either side of straight back.</description>
				<icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon>
				<gridCoordinate>(16, 10)</gridCoordinate>
				<work>5000</work>
				<ingredients>
					<Steel>135</Steel>
					<ComponentIndustrial>11</ComponentIndustrial>
				</ingredients>
				<disableIfUpgradeNodesEnabled>
					<li>HogShuttle_DoorGunMMG</li>
					<li>HogShuttle_DoorGunHMG</li>
				</disableIfUpgradeNodesEnabled>
				<upgrades>
					<li Class="Vehicles.VehicleUpgrade">
						<roles>
							<li>
								<key>DoorGunner</key>
								<label>door gunner</label>
								<handlingTypes>Turret</handlingTypes>
								<slots>1</slots>
								<slotsToOperate>1</slotsToOperate>
								<turretIds>
									<li>doorGun</li>
								</turretIds>
								<hitbox>
									<cells>
										<li>(0, -3)</li>
										<li>(1, -3)</li>
									</cells>
								</hitbox>
								<exposed>true</exposed>
								<chanceToHit>0.3</chanceToHit>
							</li>
						</roles>
					</li>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li Class="VTOLVehicle.VtolVehicleTurret">
								<turretDef>TGBM_ExposedMinigun</turretDef>
								<renderProperties>
									<north>(0, -3.1)</north>
								</renderProperties>
								<gizmoLabel>Door gun</gizmoLabel>
								<defaultAngleRotated>180</defaultAngleRotated>
								<angleRestricted>(120, 240)</angleRestricted>
								<aimPieOffset>(0, -3.1)</aimPieOffset>
								<rotateVehicleToTargetWhileTargeting>false</rotateVehicleToTargetWhileTargeting>
								<returnToDefaultAfterTicks>180</returnToDefaultAfterTicks>
								<drawLayer>1</drawLayer>
								<key>doorGun</key>
							</li>
						</turrets>
					</li>
				</upgrades>
			</li>

			<!-- A single autocannon in a roof turret behind the cockpit (Defs/TurretDefs/HogShuttle_Autocannon.xml). It traverses on its
			     own, 30 degrees either side of the nose, without steering the airframe, like the Hind's chin turret. No fire points,
			     which made shells curve under CE. No role lists the turret, so pawns incapable of violence can still fly;
			     PilotGunExtension on the Hog (HogShuttle.dll) stops them firing it. Conflicts with the front minigun. -->
			<li>
				<key>HogShuttle_Autocannon</key>
				<label>Autocannon</label>
				<description>An autocannon in a roof turret, at the cost of 30 kg of cargo space. Traverses 30 degrees either side of the nose. The pilot fires it. A pilot incapable of violence can fly, but can't fire it.</description>
				<icon>HogShuttle/Upgrade_Autocannon</icon>
				<gridCoordinate>(22, 10)</gridCoordinate>
				<work>3000</work>
				<ingredients>
					<Steel>100</Steel>
					<Plasteel>15</Plasteel>
					<ComponentIndustrial>3</ComponentIndustrial>
				</ingredients>
				<disableIfUpgradeNodesEnabled>
					<li>HogShuttle_FrontMinigun</li>
				</disableIfUpgradeNodesEnabled>
				<upgrades>
					<li Class="Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>CargoCapacity</def>
								<value>-30</value>
								<type>Add</type>
							</li>
						</vehicleStats>
					</li>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li Class="VTOLVehicle.VtolVehicleTurret">
								<turretDef>HogShuttle_Autocannon</turretDef>
								<renderProperties>
									<north>(0, 1.84)</north>
								</renderProperties>
								<gizmoLabel>Autocannon</gizmoLabel>
								<aimPieOffset>(0, 3.32)</aimPieOffset>
								<angleRestricted>(-30, 30)</angleRestricted>
								<rotateVehicleToTargetWhileTargeting>false</rotateVehicleToTargetWhileTargeting>
								<returnToDefaultAfterTicks>180</returnToDefaultAfterTicks>
								<drawLayer>1</drawLayer>
								<key>autocannon</key>
							</li>
						</turrets>
					</li>
				</upgrades>
			</li>

			<!-- One minigun under the starboard wing beside the cockpit (Defs/TurretDefs/HogShuttle_FrontMinigun.xml). Fixed forward: the
			     pilot fires it (PilotGunExtension on the Hog) and aims by turning the shuttle, and VTOL's combat hover steers for it
			     (key frontGun). Half the price and work of the pair of door miniguns on the Louie. Conflicts with the autocannon. -->
			<li>
				<key>HogShuttle_FrontMinigun</key>
				<label>Front minigun</label>
				<description>A minigun slung under the starboard wing beside the cockpit. Fixed forward: the pilot fires it and aims by turning the shuttle. A pilot incapable of violence can fly, but can't fire it.</description>
				<icon>TGBM_ThirdParty_UI/VVEU_Upgrade_Turret</icon>
				<gridCoordinate>(22, 16)</gridCoordinate>
				<work>5000</work>
				<ingredients>
					<Steel>135</Steel>
					<ComponentIndustrial>11</ComponentIndustrial>
				</ingredients>
				<disableIfUpgradeNodesEnabled>
					<li>HogShuttle_Autocannon</li>
				</disableIfUpgradeNodesEnabled>
				<upgrades>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li Class="VTOLVehicle.VtolVehicleTurret">
								<turretDef>HogShuttle_FrontMinigun</turretDef>
								<renderProperties>
									<north>(1.2, 1.95)</north>
								</renderProperties>
								<gizmoLabel>Front minigun</gizmoLabel>
								<aimPieOffset>(1.2, 3.13)</aimPieOffset>
								<angleRestricted>(-6, 6)</angleRestricted>
								<rotateVehicleToTargetWhileTargeting>true</rotateVehicleToTargetWhileTargeting>
								<returnToDefaultAfterTicks>120</returnToDefaultAfterTicks>
								<!-- Below the airframe, so the wing covers the receiver: see the Hind's chin turret. -->
								<drawLayer>-8</drawLayer>
								<key>frontGun</key>
							</li>
						</turrets>
					</li>
				</upgrades>
			</li>
		</nodes>
	</Vehicles.UpgradeTreeDef>
</Defs>
