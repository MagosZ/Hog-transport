<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Rear door guns: the three door-gun options of the Louie in "VVE - Secondary Weapons" (tgbm.vve.secondary.weapons),
	     one gun each instead of two. Stats copied from its TGBM_WisentMMG, TGBM_WisentHMG and TGBM_ExposedMinigun so
	     the Hog doesn't need that mod; vanilla bullets and sounds. With that mod active,
	     Mods/VVESecondaryWeapons/Patches/HogShuttle_DoorGunArt.xml swaps in its gun art and shot sounds.
	     With Combat Extended, Mods/CombatExtended/Patches/HogShuttle_DoorGuns_CE.xml gives them CE calibres. -->

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HogShuttle_DoorMMG</defName>
		<label>door medium machine gun</label>
		<description>A rifle-calibre machine gun on a pintle at the rear door.</description>
		<turretType>Rotatable</turretType>
		<shotSound>GunShotA</shotSound>
		<projectile>Bullet_MiniTurret</projectile>
		<reloadTimer>2.4</reloadTimer>
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(1, 1)</li>
				<li>(2, 0.75)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		<warmUpTimer>1.2</warmUpTimer>
		<chargePerAmmoCount>0.25</chargePerAmmoCount>
		<magazineCapacity>75</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2.2</rotationSpeed>
		<projectileOffset>1</projectileOffset>
		<maxRange>28.9</maxRange>
		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		<attachProjectileFlag>VVE_Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>6</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>30~60</ticksBetweenBursts>
				<burstsTillWarmup>3</burstsTillWarmup>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
				<applyShooterAccuracy>true</applyShooterAccuracy>
				<accuracyTouch>0.40</accuracyTouch>
				<accuracyShort>0.80</accuracyShort>
				<accuracyMedium>0.75</accuracyMedium>
				<accuracyLong>0.70</accuracyLong>
			</li>
		</fireModes>
		<graphicData>
			<texPath>HogShuttle/Gun_MMG</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>Cutout</shaderType>
			<drawSize>(2.2, 2.2)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HogShuttle_DoorHMG</defName>
		<label>door heavy machine gun</label>
		<description>A wide-calibre heavy machine gun on a pintle at the rear door.</description>
		<turretType>Rotatable</turretType>
		<shotSound>Shot_HeavySMG</shotSound>
		<projectile>HogShuttle_Bullet_HMG</projectile>
		<reloadTimer>4</reloadTimer>
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(1, 1)</li>
				<li>(2, 0.75)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		<warmUpTimer>1.4</warmUpTimer>
		<chargePerAmmoCount>0.25</chargePerAmmoCount>
		<magazineCapacity>75</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2</rotationSpeed>
		<projectileOffset>1.5</projectileOffset>
		<maxRange>32.9</maxRange>
		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		<attachProjectileFlag>VVE_Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>6</shotsPerBurst>
				<ticksBetweenShots>9</ticksBetweenShots>
				<ticksBetweenBursts>120</ticksBetweenBursts>
				<burstsTillWarmup>2</burstsTillWarmup>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
				<applyShooterAccuracy>true</applyShooterAccuracy>
				<accuracyTouch>0.40</accuracyTouch>
				<accuracyShort>0.80</accuracyShort>
				<accuracyMedium>0.75</accuracyMedium>
				<accuracyLong>0.70</accuracyLong>
			</li>
		</fireModes>
		<graphicData>
			<texPath>HogShuttle/Gun_HMG</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>Cutout</shaderType>
			<drawSize>(2.5, 2.5)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HogShuttle_DoorMinigun</defName>
		<label>door minigun</label>
		<description>A rotary machine gun on a pintle at the rear door, driven by an electric motor.</description>
		<turretType>Rotatable</turretType>
		<shotSound>Shot_Minigun</shotSound>
		<projectile>Bullet_Minigun</projectile>
		<reloadTimer>4</reloadTimer>
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(1, 1)</li>
				<li>(2, 0.75)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		<warmUpTimer>2.0</warmUpTimer>
		<chargePerAmmoCount>0.25</chargePerAmmoCount>
		<magazineCapacity>200</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2</rotationSpeed>
		<projectileOffset>1</projectileOffset>
		<maxRange>30.9</maxRange>
		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		<attachProjectileFlag>VVE_Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>25</shotsPerBurst>
				<ticksBetweenShots>2</ticksBetweenShots>
				<ticksBetweenBursts>30~60</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
				<applyShooterAccuracy>true</applyShooterAccuracy>
				<accuracyTouch>0.20</accuracyTouch>
				<accuracyShort>0.30</accuracyShort>
				<accuracyMedium>0.25</accuracyMedium>
				<accuracyLong>0.20</accuracyLong>
			</li>
		</fireModes>
		<graphicData>
			<texPath>HogShuttle/Gun_Minigun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>Cutout</shaderType>
			<drawSize>(2.5, 2.5)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>

	<!-- The heavy gun's bullet: TGBM_Bullet_HMG's stats (.50 BMG generic). -->
	<ThingDef ParentName="BaseBullet">
		<defName>HogShuttle_Bullet_HMG</defName>
		<label>heavy machine gun bullet</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>32</damageAmountBase>
			<stoppingPower>3</stoppingPower>
			<speed>90</speed>
		</projectile>
	</ThingDef>
</Defs>
