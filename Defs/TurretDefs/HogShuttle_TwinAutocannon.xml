<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- The roof gun, fitted by the HogShuttle_TwinAutocannon upgrade (Defs/HogShuttle_UpgradeTree.xml). Vanilla's autocannon
	     turret (Turret_Autocannon, Gun_AutocannonTurret), doubled where two barrels change the number: burst 3 becomes 6,
	     17 ticks apart becomes 9 (8.5 rounded up; each barrel keeps its own rhythm), barrel durability 90 becomes 180, and then
	     +50% for a 270-round magazine. Range is 10% under the original's 32.9 at the long end (29.6). Unchanged: cooldown 3.5 s
	     (210 ticks), no warm-up, minimum range 8.9, the shell, and 2 steel per round.
	     Vehicle Framework has no accuracy stats, so spreadRadius stands in for them. -->
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HogShuttle_TwinAutocannon</defName>
		<label>twin-linked autocannon</label>
		<description>Two autocannons bound side by side in a roof mount and fed from a 270-round magazine. The mount is fixed forward, so the pilot aims it by turning the shuttle. Reloads with steel.</description>
		<turretType>Rotatable</turretType>
		<gizmoIconTexPath>HogShuttle/Upgrade_TwinAutocannon</gizmoIconTexPath>

		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
		<genericAmmo>true</genericAmmo>
		<magazineCapacity>270</magazineCapacity>
		<chargePerAmmoCount>2</chargePerAmmoCount>
		<reloadTimer>10</reloadTimer>
		<autoRefuelProportion>1</autoRefuelProportion>

		<projectile>Bullet_AutocannonTurret</projectile>
		<shotSound>Shot_Autocannon</shotSound>
		<warmUpTimer>0</warmUpTimer>
		<autoSnapTargeting>true</autoSnapTargeting>
		<rotationSpeed>6</rotationSpeed>
		<!-- Shots leave from between the muzzles. -->
		<projectileOffset>1.48</projectileOffset>
		<minRange>8.9</minRange>
		<maxRange>29.6</maxRange>

		<motes>
			<li>
				<moteDef>Mote_CannonFlash</moteDef>
				<offset>(0, 0, 1.48)</offset>
				<scale>0.45</scale>
			</li>
		</motes>

		<fireModes>
			<li>
				<shotsPerBurst>6</shotsPerBurst>
				<ticksBetweenShots>9</ticksBetweenShots>
				<ticksBetweenBursts>210</ticksBetweenBursts>
				<spreadRadius>1</spreadRadius>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
		</fireModes>

		<!-- Square, 4 cells, the same pixels per cell as the body; the image's centre is the pivot. -->
		<graphicData>
			<texPath>HogShuttle/TwinAutocannon</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<drawSize>(4, 4)</drawSize>
		</graphicData>
	</Vehicles.VehicleTurretDef>
</Defs>
