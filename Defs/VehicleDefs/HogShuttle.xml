<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- The flight setup follows the Hind Helicopter Gunship (the only open example of a VTOL Vehicle
	     aircraft): VTOL Vehicle flies it on the local map, Vehicle Framework's launcher flies it on the
	     world map. VTOL Vehicle is closed source, so field names come from that example. -->
	<Vehicles.VehicleDef ParentName="BaseVehiclePawn">
		<defName>HogShuttle</defName>
		<label>Hog shuttle</label>
		<description>A small, boxy spacer shuttle. Its thrusters let it hover over the ground like a VTOL aircraft, and its sealed hull carries crew and passengers between the surface and orbit.\n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1 (Intellectual 6+, or any pilot with the auxiliary flight computer), co-pilot x1 (optional)\n&lt;color=#bb8f04&gt;Passengers:&lt;/color&gt; 8\n&lt;color=#bb8f04&gt;Cargo:&lt;/color&gt; 1000 kg\n&lt;color=#bb8f04&gt;Fuel type:&lt;/color&gt; Chemfuel</description>
		<thingClass>VTOLVehicle.VtolVehiclePawn</thingClass>
		<buildDef>HogShuttle_Blueprint</buildDef>

		<drawerType>RealtimeOnly</drawerType>
		<category>Pawn</category>
		<type>Air</type>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Spacer</techLevel>
		<canCaravan>false</canCaravan>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Gas</altitudeLayer>
		<passability>Standable</passability>
		<pathCost>250</pathCost>
		<fillPercent>0</fillPercent>
		<size>(4,7)</size>
		<rotatable>true</rotatable>
		<selectable>true</selectable>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>

		<!-- Placeholder art (Source/Art/body_views.py): one top-down view, Body.png, which VTOL Vehicle turns to the
		     aircraft's heading (as the Hind's), with its paint mask Body_m.png (red = hull and nacelles, green =
		     cockpit armour and wing stripe, blue = wings). Square drawSize (7,7), like the Hind's, so it turns
		     cleanly; the wings are painted one cell past the 4-wide footprint on each side (art only). -->
		<graphicData>
			<texPath>HogShuttle/Body</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(7,7)</drawSize>
			<color>(176, 178, 182)</color>
			<colorTwo>(86, 128, 98)</colorTwo>
			<colorThree>(150, 152, 156)</colorThree>
		</graphicData>

		<vehicleStats>
			<Mass>1800</Mass>
			<CargoCapacity>1000</CargoCapacity>
			<RepairRate>1</RepairRate>
			<FlightSpeed>30</FlightSpeed>
		</vehicleStats>

		<statBases>
			<Flammability>0.3</Flammability>
			<MarketValue>9000</MarketValue>
			<ArmorRating_Heat>1.0</ArmorRating_Heat>
		</statBases>

		<components>
			<!-- Generated by Source/Art/components.py: edit the table there and re-run it. -->
			<!-- Covers every cell. -->
			<li>
				<key>Hull</key>
				<label>hull</label>
				<health>900</health>
				<hitWeight>3</hitWeight>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.50</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.90</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<side>Body</side>
				</hitbox>
			</li>
			<!-- The cockpit box at the front centre. -->
			<li>
				<key>Cockpit</key>
				<label>cockpit</label>
				<health>200</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, 3)</li>
						<li>(1, 3)</li>
					</cells>
				</hitbox>
			</li>
			<!-- The Arvus' two ducted turbofans, on the sides: they lift and push, and they are the engines (VVE's engine and rotor mast). Priority: flight speed and control never exceed what the fans' state allows. They don't explode. -->
			<li>
				<key>ThrusterPort</key>
				<label>port turbofan</label>
				<health>220</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(-1, 1)</li>
						<li>(-1, 0)</li>
						<li>(-1, -1)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
			<li>
				<key>ThrusterStarboard</key>
				<label>starboard turbofan</label>
				<health>220</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(2, 1)</li>
						<li>(2, 0)</li>
						<li>(2, -1)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
					<li>FlightControl</li>
				</categories>
			</li>
			<!-- Wings: the hull's armour (VVE's stabilizers and rudder). -->
			<li>
				<key>WingPort</key>
				<label>port wing</label>
				<health>300</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.50</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.90</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(-1, 2)</li>
						<li>(-1, 1)</li>
						<li>(-1, 0)</li>
						<li>(-1, -1)</li>
						<li>(-1, -2)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
			<li>
				<key>WingStarboard</key>
				<label>starboard wing</label>
				<health>300</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.50</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.90</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(2, 2)</li>
						<li>(2, 1)</li>
						<li>(2, 0)</li>
						<li>(2, -1)</li>
						<li>(2, -2)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightControl</li>
				</categories>
			</li>
			<!-- The Arvus lands on three skids (VVE's landing skids): one under the nose, two at the rear sides. -->
			<li>
				<key>SkidFront</key>
				<label>front skid</label>
				<health>120</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, 2)</li>
						<li>(1, 2)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SkidPort</key>
				<label>port skid</label>
				<health>120</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(-1, 0)</li>
						<li>(-1, -1)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<li>
				<key>SkidStarboard</key>
				<label>starboard skid</label>
				<health>120</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(2, 0)</li>
						<li>(2, -1)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<!-- The cargo bay's rear door. -->
			<li>
				<key>RearDoor</key>
				<label>rear door</label>
				<health>150</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(-1, -3)</li>
						<li>(0, -3)</li>
						<li>(1, -3)</li>
						<li>(2, -3)</li>
					</cells>
				</hitbox>
			</li>
			<li>
				<key>FuelIntake</key>
				<label>fuel intake</label>
				<health>75</health>
				<depth>External</depth>
				<armor>
					<ArmorRating_Blunt>0.45</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.80</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, -2)</li>
						<li>(1, -2)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<!-- VVE's transmission. -->
			<li>
				<key>FuelPumps</key>
				<label>fuel pumps</label>
				<health>75</health>
				<depth>Internal</depth>
				<armor>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, -1)</li>
						<li>(1, -1)</li>
					</cells>
				</hitbox>
				<categories>
					<li>FlightSpeed</li>
				</categories>
			</li>
			<!-- In the centre. A critically damaged tank (20% health or less) can blow on a hit. -->
			<li>
				<key>FuelTank</key>
				<label>fuel tank</label>
				<health>180</health>
				<depth>Internal</depth>
				<armor>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, 1)</li>
						<li>(0, 0)</li>
						<li>(1, 1)</li>
						<li>(1, 0)</li>
					</cells>
				</hitbox>
				<reactors>
					<li Class="Vehicles.Reactor_FuelLeak" />
					<li Class="Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.08</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>Bomb</damageDef>
						<damage>10</damage>
					</li>
				</reactors>
			</li>
			<!-- VVE's dashboard, behind the cockpit glass. -->
			<li>
				<key>Avionics</key>
				<label>avionics</label>
				<health>75</health>
				<hitWeight>2</hitWeight>
				<depth>Internal</depth>
				<armor>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, 3)</li>
						<li>(1, 3)</li>
					</cells>
				</hitbox>
			</li>
			<!-- VVE's upholstery. -->
			<li>
				<key>CabinSeats</key>
				<label>cabin seats</label>
				<health>75</health>
				<hitWeight>2</hitWeight>
				<depth>Internal</depth>
				<armor>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, 2)</li>
						<li>(1, 2)</li>
					</cells>
				</hitbox>
			</li>
			<!-- VVE's servos. -->
			<li>
				<key>ControlServos</key>
				<label>control servos</label>
				<health>105</health>
				<hitWeight>2</hitWeight>
				<depth>Internal</depth>
				<armor>
					<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
					<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
				</armor>
				<hitbox>
					<cells>
						<li>(0, -1)</li>
						<li>(1, -1)</li>
					</cells>
				</hitbox>
			</li>
		</components>

		<soundOneShotsOnEvent>
			<li>
				<key>IgnitionOn</key>
				<value>VVE_VehicleStart</value>
			</li>
			<li>
				<key>IgnitionOff</key>
				<value>VVE_VehicleStart</value>
			</li>
		</soundOneShotsOnEvent>

		<comps>
			<li Class="VTOLVehicle.CompProperties_VtolAirborneMoveBlocker" />

			<!-- World-map flight. spaceFlight: with Odyssey, Vehicle Framework lets it target gravships,
			     space bases and sites, and asteroids. The 1-tick launch and landing are the Hind's: VTOL
			     Vehicle draws the take-off and landing on the map itself. -->
			<li Class="Vehicles.CompProperties_VehicleLauncher">
				<spaceFlight>true</spaceFlight>
				<!-- Vehicle Framework's default (10), as VVE's aircraft use. -->
				<fuelConsumptionWorldMultiplier>10</fuelConsumptionWorldMultiplier>
				<launchProtocol Class="Vehicles.DefaultTakeoff">
					<launchProperties>
						<maxTicks>1</maxTicks>
						<renderShadow>false</renderShadow>
					</launchProperties>
					<landingProperties>
						<maxTicks>1</maxTicks>
						<renderShadow>false</renderShadow>
					</landingProperties>
				</launchProtocol>
			</li>

			<!-- World-map range on a full tank, from Vehicle Framework's launch cost:
			     fuel per tile = fuelConsumptionRate x launcher multiplier / (60 x FlightSpeed)
			     = 300 x 10 / (60 x 30) = 1.67 (the rate follows FlightSpeed so speed doesn't change it),
			     so 1200 fuel = 720 tiles in the air; half the planet's circumference is about 330 tiles
			     (100% coverage, estimate). Space costs more (OrbitTransitExtension below): 50 per change
			     between surface and space, and legs ending in space cost 10x per tile (17 fuel per tile).
			     VVE's helicopters on a full tank: Mosquito 309, Louie 443, Cherokee 152 tiles. -->
			<li Class="Vehicles.CompProperties_FueledTravel">
				<fuelType>Chemfuel</fuelType>
				<leakDef>Filth_Fuel</leakDef>
				<fuelCapacity>1200</fuelCapacity>
				<fuelConsumptionRate>300</fuelConsumptionRate>
				<fuelConsumptionCondition>Flying</fuelConsumptionCondition>
				<autoRefuelPercent>1</autoRefuelPercent>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
			</li>
			<!-- Upgrades tab (Defs/HogShuttle_UpgradeTree.xml). -->
			<li Class="Vehicles.CompProperties_UpgradeTree">
				<def>HogShuttle_UpgradeTree</def>
			</li>
		</comps>

		<properties>
			<diagonalRotation>true</diagonalRotation>
			<visibilityWeight>4</visibilityWeight>
			<roles>
				<li>
					<key>Pilot</key>
					<label>pilot</label>
					<handlingTypes>Movement</handlingTypes>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					<hitbox>
						<side>Front</side>
					</hitbox>
					<exposed>false</exposed>
					<chanceToHit>0.1</chanceToHit>
				</li>
				<li>
					<!-- A seat with no handling: never needed to fly. -->
					<key>CoPilot</key>
					<label>co-pilot</label>
					<slots>1</slots>
					<slotsToOperate>0</slotsToOperate>
					<hitbox>
						<side>Front</side>
					</hitbox>
					<exposed>false</exposed>
					<chanceToHit>0.1</chanceToHit>
				</li>
				<li>
					<key>Passenger</key>
					<label>passenger</label>
					<slots>8</slots>
					<hitbox>
						<side>Body</side>
					</hitbox>
					<exposed>false</exposed>
					<chanceToHit>0.03</chanceToHit>
				</li>
			</roles>
		</properties>

		<modExtensions>
			<!-- Sealed cabin (HogShuttle.dll): seats and cargo hold stay at this temperature, and pawns aboard take no
			     vacuum (with Odyssey). Vehicle Framework keeps ticking both, so without it they freeze in space. -->
			<li Class="HogShuttle.SealedCabinExtension">
				<temperature>21</temperature>
			</li>
			<!-- Orbit costs (HogShuttle.dll): 50 fuel per change between surface and space, and legs that end in
			     space cost 10x per tile (vanilla's orbit rangeDistanceFactor is 20, but part of that may be its larger orbit tiles). -->
			<!-- Pilot skill (HogShuttle.dll): the pilot seat only counts a pawn with Intellectual 6 or more, unless the
			     auxiliary flight computer upgrade is installed. Vehicle Framework then treats the Hog as having no
			     pilot: it can't move or fly, and boarding won't seat an under-skilled pawn there. -->
			<li Class="HogShuttle.PilotSkillExtension">
				<role>Pilot</role>
				<skill>Intellectual</skill>
				<minLevel>6</minLevel>
				<waivedByUpgradeNode>HogShuttle_FlightComputer</waivedByUpgradeNode>
			</li>
			<li Class="HogShuttle.OrbitTransitExtension">
				<transitFuel>50</transitFuel>
				<spaceDistanceFactor>10</spaceDistanceFactor>
			</li>
			<!-- Local-map flight. Movement and curve values start from the Hind's, a bit slower to turn
			     and steadier in the air. -->
			<li Class="VTOLVehicle.AircraftProperties">
				<moveSpeed>0.35</moveSpeed>
				<turnSpeed>1.60</turnSpeed>
				<accelerationPerTick>0.0035</accelerationPerTick>
				<decelerationPerTick>0.0020</decelerationPerTick>
				<arrivalStopSpeed>0.001</arrivalStopSpeed>
				<angularAccelerationPerTick>0.022</angularAccelerationPerTick>
				<angularDecelerationPerTick>0.020</angularDecelerationPerTick>
				<angularStopTolerance>0.01</angularStopTolerance>
				<highSpeedTurnStartSpeed>0.18</highSpeedTurnStartSpeed>
				<highSpeedTurnFullSpeed>0.32</highSpeedTurnFullSpeed>
				<highSpeedTurnSpeedFactor>0.58</highSpeedTurnSpeedFactor>
				<turnSpeedLimitChangePerTick>1.6</turnSpeedLimitChangePerTick>
				<turnSlowdownAngle>60</turnSlowdownAngle>
				<minTurnSpeedFactor>0.15</minTurnSpeedFactor>
				<facingSpeedLimitAngle>30</facingSpeedLimitAngle>
				<offFacingMaxSpeed>0.05</offFacingMaxSpeed>
				<facingSpeedLimitChangePerTick>0.003</facingSpeedLimitChangePerTick>
				<directionalHoverMaxSpeed>0.12</directionalHoverMaxSpeed>
				<directionalHoverEnterRadius>16</directionalHoverEnterRadius>
				<directionalHoverEnterSpeed>0.14</directionalHoverEnterSpeed>
				<microMoveDistance>4</microMoveDistance>
				<microMoveMaxSpeed>0.03</microMoveMaxSpeed>
				<microMoveAccelerationPerTick>0.00006</microMoveAccelerationPerTick>
				<microMoveDecelerationPerTick>0.00006</microMoveDecelerationPerTick>
				<!-- No weapons yet. -->
				<combatDirectionalHoverEnabled>false</combatDirectionalHoverEnabled>
				<takeoffDrawCurve>
					<mode>MonotoneCubic</mode>
					<points>
						<li>(0.00, 0.00)</li>
						<li>(0.10, 0.01)</li>
						<li>(0.17, 0.05)</li>
						<li>(0.25, 0.13)</li>
						<li>(0.46, 0.59)</li>
						<li>(0.63, 0.85)</li>
						<li>(0.77, 0.95)</li>
						<li>(1.00, 1.00)</li>
					</points>
				</takeoffDrawCurve>
				<landingDrawCurve>
					<mode>MonotoneCubic</mode>
					<points>
						<li>(0.00, 1.00)</li>
						<li>(0.09, 0.99)</li>
						<li>(0.16, 0.96)</li>
						<li>(0.22, 0.92)</li>
						<li>(0.29, 0.83)</li>
						<li>(0.46, 0.44)</li>
						<li>(0.59, 0.19)</li>
						<li>(0.70, 0.09)</li>
						<li>(0.82, 0.03)</li>
						<li>(1.00, 0.00)</li>
					</points>
				</landingDrawCurve>
				<takeoffMoveStartProgress>0.35</takeoffMoveStartProgress>
				<landingApproachMaxDistance>8</landingApproachMaxDistance>
				<landingApproachSafetyTicks>15</landingApproachSafetyTicks>
				<landingTouchdownRadius>0.05</landingTouchdownRadius>
				<landingAlignmentHoldDrawProgress>0.2</landingAlignmentHoldDrawProgress>
				<takeoffTicks>360</takeoffTicks>
				<landingTicks>360</landingTicks>
				<arrivalRadius>0.05</arrivalRadius>
				<landingCollisionDamageFactor>1</landingCollisionDamageFactor>
				<!-- "Rotor" timings are the thrusters spooling up and down. -->
				<rotorStartupTicks>240</rotorStartupTicks>
				<rotorShutdownTicks>300</rotorShutdownTicks>
				<rotorReadyThreshold>0.98</rotorReadyThreshold>
				<rotorSustainerStartDelayTicks>60</rotorSustainerStartDelayTicks>
				<rotorSustainerFadeInTicks>120</rotorSustainerFadeInTicks>
				<rotorSustainerFadeOutTicks>120</rotorSustainerFadeOutTicks>
				<fuelConsumptionPerTick>0.006</fuelConsumptionPerTick>
				<flightDrawScale>1.15</flightDrawScale>
				<flightJitterAmplitude>(0.5, 0.4)</flightJitterAmplitude>
				<flightJitterTargetIntervalTicks>110</flightJitterTargetIntervalTicks>
				<flightJitterSmoothTimeTicks>160</flightJitterSmoothTimeTicks>
				<flightJitterMaxSpeed>0.003</flightJitterMaxSpeed>
				<flightAngleJitterAmplitude>0.6</flightAngleJitterAmplitude>
				<flightAngleJitterTargetIntervalTicks>110</flightAngleJitterTargetIntervalTicks>
				<flightAngleJitterSmoothTimeTicks>160</flightAngleJitterSmoothTimeTicks>
				<flightAngleJitterMaxSpeed>0.06</flightAngleJitterMaxSpeed>
				<bodyAltitudeOffset>0.02</bodyAltitudeOffset>
				<drawShadow>true</drawShadow>
				<shadowTexturePath>HogShuttle/Shadow</shadowTexturePath>
				<shadowScale>1</shadowScale>
				<shadowAlpha>1.5</shadowAlpha>
				<shadowOffsetX>-0.3</shadowOffsetX>
				<shadowOffsetZ>-0.3</shadowOffsetZ>
				<syncShadowWithSun>true</syncShadowWithSun>
				<shadowSunOffsetFactor>1.3</shadowSunOffsetFactor>
				<shadowSunStretchFactor>0.0</shadowSunStretchFactor>
				<shadowMaxStretch>1.8</shadowMaxStretch>
				<!-- Rocket engine hum (VVE's, used by its Frog) instead of rotor blades. -->
				<rotorSustainerDef>VVE_VehicleEngineRocket</rotorSustainerDef>
				<flightRotorSustainerDef>VVE_VehicleEngineRocket</flightRotorSustainerDef>
				<rotorSustainerMinVolume>0.05</rotorSustainerMinVolume>
				<rotorSustainerMaxVolume>1</rotorSustainerMaxVolume>
				<rotorSustainerPitchBySpeed>true</rotorSustainerPitchBySpeed>
				<rotorSustainerMinPitch>1</rotorSustainerMinPitch>
				<rotorSustainerMaxPitch>1.12</rotorSustainerMaxPitch>
				<rotorSustainerPitchSpeedForMax>0.3</rotorSustainerPitchSpeedForMax>
				<rotorSustainerPitchSmoothTicks>45</rotorSustainerPitchSmoothTicks>
				<rotors>
					<!-- The Hog has no rotor. VTOL Vehicle is built around rotors and its code isn't public, so
					     one invisible, non-spinning rotor stands in to keep it on the tested path. -->
					<li>
						<stoppedTexturePath>HogShuttle/Transparent</stoppedTexturePath>
						<spinningTexturePath>HogShuttle/Transparent</spinningTexturePath>
						<localOffset>(0, 0)</localOffset>
						<drawSize>(1, 1)</drawSize>
						<scale>1</scale>
						<altitudeOffset>0.01</altitudeOffset>
						<rotationSpeed>0</rotationSpeed>
						<rotationDirection>1</rotationDirection>
						<accelerationTicks>240</accelerationTicks>
						<drawShadow>false</drawShadow>
					</li>
				</rotors>
			</li>
			<li Class="VTOLVehicle.VtolCrewTransferProperties">
				<boardNearbyRangeType>Circle</boardNearbyRangeType>
				<boardNearbyRadius>8</boardNearbyRadius>
				<boardNearbyExpandVehicleRectBy>2</boardNearbyExpandVehicleRectBy>
				<boardNearbyAllowHumanlikes>true</boardNearbyAllowHumanlikes>
				<boardNearbyAllowAnimalsInPassengerRoles>true</boardNearbyAllowAnimalsInPassengerRoles>
				<boardNearbyAllowMechanoidsInPassengerRoles>true</boardNearbyAllowMechanoidsInPassengerRoles>
			</li>
		</modExtensions>
	</Vehicles.VehicleDef>

	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>HogShuttle_Blueprint</defName>
		<label>Hog shuttle</label>
		<description>A small, boxy spacer shuttle. Its thrusters let it hover over the ground like a VTOL aircraft, and its sealed hull carries crew and passengers between the surface and orbit.\n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Pilot x1 (Intellectual 6+, or any pilot with the auxiliary flight computer), co-pilot x1 (optional)\n&lt;color=#bb8f04&gt;Passengers:&lt;/color&gt; 8\n&lt;color=#bb8f04&gt;Cargo:&lt;/color&gt; 1000 kg\n&lt;color=#bb8f04&gt;Fuel type:&lt;/color&gt; Chemfuel</description>
		<uiIconPath>HogShuttle/BuildIcon</uiIconPath>

		<graphicData>
			<texPath>HogShuttle/Body</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(7,7)</drawSize>
		</graphicData>

		<statBases>
			<MaxHitPoints>1200</MaxHitPoints>
			<WorkToBuild>48000</WorkToBuild>
			<Flammability>0.3</Flammability>
		</statBases>

		<size>(4,7)</size>

		<researchPrerequisites>
			<li>HogShuttle_Research</li>
		</researchPrerequisites>

		<!-- About 1.7x Odyssey's passenger shuttle (250 steel, 150 plasteel, 6 components, 1 shuttle
		     engine). Without Odyssey: 3 + 6 advanced components. With Odyssey,
		     Mods/Odyssey/Patches/HogShuttle_Cost.xml turns the 6 extra into 2 shuttle engines. -->
		<costList>
			<Steel>450</Steel>
			<Plasteel>250</Plasteel>
			<ComponentIndustrial>10</ComponentIndustrial>
			<ComponentSpacer>9</ComponentSpacer>
		</costList>

		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<thingToSpawn>HogShuttle</thingToSpawn>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
	</Vehicles.VehicleBuildDef>
</Defs>
